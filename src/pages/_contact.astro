---
import { Image } from "@astrojs/image/components";
import config from "@config/config.json";
import Base from "@layouts/Base.astro";
import { getEntryBySlug } from "astro:content";

const entry = await getEntryBySlug("contact", "index");
const { contact_form_action } = config.params;
const contact = entry.data;
---

<Base
  title={contact.title}
  meta_title={contact.meta_title}
  description={contact.description}
  image={contact.image}
>
  <section class="section">
    <div class="container">
      <div class="row">
        <div class="mb-10 text-center md:col-6 md:order-2 md:mb-0">
          <div class="contact-img relative inline-flex pb-5 pl-5">
            <Image
              src="/images/email.png"
              height={544}
              width={500}
              alt="email"
            />
            <Image
              class="absolute bottom-0 left-0 -z-[1] h-14 w-14 hidden"
              src="/images/blob-shape-2.png"
              alt=""
              height={300}
              width={300}
            />
          </div>
        </div>
        <div class="md:col-6 md:order-1 self-center flex">
          <form
            id="contact-form"
            class="lg:max-w-[484px]"
            action={contact_form_action}
            method="POST"
          >
            <input name="_redirect" type="hidden" value="https://www.financeand.nl/success" />
            <input name="_redirect_error" type="hidden" value="https://www.financeand.nl/error" />

            <!-- Honeypot: hidden from humans via CSS, bots fill it and get silently rejected -->
            <div aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;overflow:hidden;" tabindex="-1">
              <label for="contact_url">Website URL</label>
              <input type="text" id="contact_url" name="contact_url" tabindex="-1" autocomplete="off" />
            </div>

            <div class="form-group mb-5">
              <label class="form-label" for="name">Full Name</label>
              <input
                class="form-control"
                type="text"
                id="name"
                name="name"
                placeholder="Your Name"
                required
              />
            </div>
            <div class="form-group mb-5">
              <label class="form-label" for="email">Email Address</label>
              <input
                class="form-control"
                type="email"
                id="email"
                name="email"
                placeholder="Your Email Address"
                required
              />
            </div>
            <div class="form-group mb-5">
              <label class="form-label" for="message">Message:</label>
              <textarea
                class="form-control h-[150px]"
                id="message"
                name="message"
                cols="30"
                rows="10"
                required></textarea>
            </div>
            <input
              id="contact-submit"
              class="btn btn-primary block w-full"
              type="submit"
              value="Send Message"
              disabled
            />
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  (function () {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const submitBtn = document.getElementById("contact-submit") as HTMLInputElement | null;
    if (!form || !submitBtn) return;

    const loadedAt = Date.now();
    // Enable the button after 3 seconds — bots submit immediately
    setTimeout(() => {
      submitBtn.disabled = false;
    }, 3000);

    form.addEventListener("submit", function (e) {
      const honeypot = form.querySelector<HTMLInputElement>('[name="contact_url"]');
      if (honeypot && honeypot.value.trim() !== "") {
        e.preventDefault();
        return;
      }

      const elapsed = Date.now() - loadedAt;
      if (elapsed < 3000) {
        e.preventDefault();
        return;
      }
    });
  })();
</script>
